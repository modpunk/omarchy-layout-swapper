BROWSER_CLASSES = {
    "chromium",
    "Chromium",
    "google-chrome",
    "Google-chrome",
    "brave-browser",
    "Brave-browser",
    "helium",
    "Helium",
    "microsoft-edge",
    "vivaldi",
