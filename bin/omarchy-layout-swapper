#!/usr/bin/env python3
# omarchy-layout-swapper — save, switch, and auto-restore Hyprland window
# layouts on Omarchy.
#
#   omarchy-layout-swapper save [name] [--force]     snapshot the current layout
#   omarchy-layout-swapper switch <name>             save current, park it, bring up <name>
#   omarchy-layout-swapper restore [name] [--keep|--close]
#   omarchy-layout-swapper list | show [name] | delete <name> | rename <a> <b>
#   omarchy-layout-swapper watch                     autosave daemon (Hyprland IPC events)
#   omarchy-layout-swapper boot                      start watch, then auto-restore or ask
#   omarchy-layout-swapper menu switch|save|delete|boot-mode
#   omarchy-layout-swapper status [--json|--short]
#
# Stdlib only. Hyprland >= 0.55 (Lua dispatchers), with legacy string
# dispatchers as a fallback, the same idiom Omarchy's own scripts use.
#
# A layout is a JSON list of window records: class, workspace, geometry,
# floating/pinned/fullscreen state, and a launch command derived at save time
# (web apps from the desktop-file index, terminals from the child shell's cwd,
# native apps from /proc). Restore is a reconcile: existing windows are
# claimed and moved into place, missing ones are launched one at a time and
# matched as they open, extras are kept, closed, or parked on a hidden
# per-layout special workspace so switching back is instant.

import glob
import json
import os
import re
import select
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from urllib.parse import urlparse

APP = "omarchy-layout-swapper"
HOME = os.path.expanduser("~")
CONFIG_DIR = os.environ.get(
    "LAYOUT_SWAPPER_CONFIG_DIR",
    os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), APP),
)
STATE_DIR = os.environ.get(
    "LAYOUT_SWAPPER_STATE_DIR",
    os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), APP),
)
LAYOUTS_DIR = os.path.join(CONFIG_DIR, "layouts")
BACKUP_DIR = os.path.join(STATE_DIR, "backups")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
ACTIVE_FILE = os.path.join(STATE_DIR, "active")
PID_FILE = os.path.join(STATE_DIR, "watch.pid")
LOCK_FILE = os.path.join(STATE_DIR, "restore.lock")
LOG_FILE = os.path.join(STATE_DIR, "watch.log")
UPDATE_NOTIFIED_FILE = os.path.join(STATE_DIR, "update-last-notified")
# Where `omarchy plugin add` cloned this plugin (a git checkout with an origin).
PLUGIN_DIR = os.environ.get(
    "LAYOUT_SWAPPER_PLUGIN_DIR",
    os.path.join(HOME, ".config", "omarchy", "plugins", "fans.omarchy.layout-swapper"),
)
SYSTEMD_USER_DIR = os.environ.get(
    "LAYOUT_SWAPPER_SYSTEMD_DIR",
    os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "systemd", "user"),
)
UPDATE_SERVICE = "omarchy-layout-swapper-update.service"
UPDATE_TIMER = "omarchy-layout-swapper-update.timer"
PROC = os.environ.get("LAYOUT_SWAPPER_PROC", "/proc")
# Test hook: a directory with clients.json / monitors.json / activeworkspace.json
# and a dispatch.log that records what would have been dispatched.
FAKE_DIR = os.environ.get("LAYOUT_SWAPPER_FAKE_DIR")
APPS_DIRS = os.environ.get(
    "LAYOUT_SWAPPER_APPS_DIRS",
    os.pathsep.join(
        [
            os.path.join(HOME, ".local", "share", "applications"),
            os.path.join(HOME, ".nix-profile", "share", "applications"),
            "/usr/share/applications",
        ]
    ),
).split(os.pathsep)
BINDINGS_FILES = os.environ.get(
    "LAYOUT_SWAPPER_BINDINGS",
    os.pathsep.join(
        [
            os.path.join(HOME, ".config", "hypr", "bindings.lua"),
            "/usr/share/omarchy/default/hypr/bindings/applications.lua",
        ]
    ),
).split(os.pathsep)

DEFAULT_CONFIG = {
    "boot": "auto",  # auto | ask
    "autosave_seconds": 5,
    "periodic_seconds": 60,
    "launch_timeout": 12,
    "backups": 5,
    "default_layout": "main",
    # Opt-in: notify a few minutes after login when a newer version is on the
    # plugin's git remote. Off until the user turns it on.
    "update_check": "off",
    # Transient / shell windows never worth restoring.
    "ignore_classes": [
        "org.omarchy.menu",
        "org.omarchy.osd",
        "org.omarchy.shell",
        "org.omarchy.about",
        "org.omarchy.launcher",
